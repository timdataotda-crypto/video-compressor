/* Drone Compressor — compact utility UI */
QWidget {
    background-color: #1a1d23;
    color: #e8eaed;
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #1a1d23;
}

QScrollArea#mainScroll {
    background-color: #1a1d23;
    border: none;
}

QScrollArea#mainScroll > QWidget > QWidget {
    background-color: #1a1d23;
}

QScrollBar:vertical {
    background: #1a1d23;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3a4150;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1a1d23;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #3a4150;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QLabel#titleLabel {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #f0f3f7;
}

QLabel#logoLabel {
    background: transparent;
    border: none;
    padding: 0;
}

QLabel#fieldLabel {
    color: #9aa3b2;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
}

QLabel#hintLabel {
    color: #9aa3b2;
    font-size: 12px;
}

QPushButton#iconButton {
    padding: 6px 8px;
    min-width: 36px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #252a33;
    border: 1px solid #3a4150;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #3d7eff;
}

QComboBox QAbstractItemView, QCompleter QAbstractItemView {
    background-color: #252a33;
    color: #e8eaed;
    selection-background-color: #3d7eff;
    border: 1px solid #3a4150;
}

QPushButton {
    background-color: #2d3440;
    border: 1px solid #3a4150;
    border-radius: 6px;
    padding: 8px 14px;
}

QPushButton:hover {
    background-color: #3a4250;
}

QPushButton:pressed {
    background-color: #222831;
}

QPushButton#startButton {
    background-color: #2f6fed;
    border: none;
    color: white;
    font-weight: 600;
    padding: 12px 24px;
    font-size: 14px;
}

QPushButton#startButton:hover {
    background-color: #4580f5;
}

QPushButton#lockButton {
    background-color: #2d4a3e;
    border: 1px solid #3d6a55;
}

QPushButton#lockButton:hover {
    background-color: #365748;
}

QListWidget#batchList {
    background-color: #1f242c;
    border: 1px solid #3a4150;
    border-radius: 6px;
    padding: 4px;
}

QListWidget#batchList::item {
    padding: 6px 8px;
}

QProgressBar {
    background-color: #252a33;
    border: 1px solid #3a4150;
    border-radius: 6px;
    text-align: center;
    height: 22px;
}

QProgressBar::chunk {
    background-color: #2f6fed;
    border-radius: 5px;
}

QTableWidget {
    background-color: #1f242c;
    gridline-color: #2e3542;
    border: 1px solid #3a4150;
    border-radius: 6px;
}

QHeaderView::section {
    background-color: #252a33;
    color: #aab2bf;
    border: none;
    padding: 6px;
}

QCheckBox {
    spacing: 8px;
}

QGroupBox {
    border: 1px solid #3a4150;
    border-radius: 8px;
    margin-top: 12px;
    padding: 14px 10px 12px 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #9aa3b2;
}
